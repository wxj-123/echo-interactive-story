{
  "name": "echo-interactive-story",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "《回声》- AIGC 驱动的互动影游小游戏",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "validate": "tsx scripts/validate-story.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "serve": "npm run validate && npm run build && npm start",
    "gen:assets": "tsx scripts/gen-assets.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jimp": "^1.6.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
