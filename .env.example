# ── 方式一：任意 OpenAI 兼容端点（填 Key 即生效）────────────────
# 已用 Agnes AI Hub 实测：https://apihub.agnes-ai.com/v1 + agnes-3.0-flash
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=
LLM_MODEL=agnes-3.0-flash

# ── 方式二：本地 Ollama（零密钥，装好后自动探测，无需改这里）──────
# 安装：https://ollama.com  然后 `ollama pull qwen2.5:7b`
# 也可以显式指定：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# 服务端口
PORT=3001
